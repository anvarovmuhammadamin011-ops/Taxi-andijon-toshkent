{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm --prefix taxi-v2/frontend install",
  "buildCommand": "npm --prefix taxi-v2/frontend run build",
  "outputDirectory": "taxi-v2/frontend/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
